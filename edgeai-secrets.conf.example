# Ejemplo de edgeai-secrets.conf. La configuración de demostración se versiona.
# No incluir tokens de GitHub ni credenciales ajenas a la red de demostración.
# local.conf lo incluye automáticamente.

# Wi-Fi (opcional). Sin SSID la Pi usa solo Ethernet.
#EDGEAI_WIFI_SSID = "MiRed"
#EDGEAI_WIFI_PSK = "mi-clave-wifi"
#EDGEAI_WIFI_COUNTRY = "CR"

# Contraseña de root para SSH y consola (por defecto "edgeai").
# Genere el hash con:  openssl passwd -6 'nueva-clave'   y escape cada $ como \$
#EDGEAI_ROOT_PASSWORD_HASH = "\$6\$sal\$hash..."

# Precargar modelos en la imagen (requiere models/ollama-models.tar).
#EDGEAI_PRELOAD_MODELS = "1"
