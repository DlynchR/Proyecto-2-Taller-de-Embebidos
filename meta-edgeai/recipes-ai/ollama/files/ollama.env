# Variables de entorno de Ollama (las carga ollama.service).
# Tras editar: systemctl restart ollama

# Solo escucha en la propia Pi: la mesa de ayuda es la única cliente.
# Para depurar desde una laptop use 0.0.0.0:11434 (sin autenticación).
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_MODELS=/var/lib/ollama/models
HOME=/var/lib/ollama

# Mantener los dos modelos (decisión + LLM) en RAM: evita recargas de varios segundos.
OLLAMA_KEEP_ALIVE=24h
OLLAMA_MAX_LOADED_MODELS=2
# Una solicitud a la vez por modelo: la RPi4 no gana nada con paralelismo.
OLLAMA_NUM_PARALLEL=1
# Contexto corto para limitar la memoria del caché KV.
OLLAMA_CONTEXT_LENGTH=2048
